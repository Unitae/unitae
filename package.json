{
    "name": "unitae",
    "license": "AGPL-3.0-only",
    "private": true,
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "build:format": "biome check --write",
        "build:db": "prisma generate",
        "start": "react-router-serve ./build/server/index.js",
        "db:migrate": "pnpm prisma migrate deploy",
        "db:seed": "pnpm prisma db seed",
        "start:dev": "react-router dev",
        "start:emails": "email dev",
        "start:worker": "pnpm tsx ./app/workers/worker.server.ts",
        "test:lint": "biome lint",
        "test:typecheck": "react-router typegen && tsc",
        "test:unit": "react-router typegen && vitest run",
        "test:unit:watch": "react-router typegen && vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:integration": "react-router typegen && vitest run --config app/tests/vitest.config.integration.ts",
        "test:e2e": "playwright test --config app/tests/playwright.config.ts",
        "test:e2e:headed": "playwright test --headed --config app/tests/playwright.config.ts",
        "test:boundaries": "eslint --no-error-on-unmatched-pattern app/features/"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1024.0",
        "@conform-to/react": "^1.19.0",
        "@conform-to/zod": "^1.19.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@inlang/paraglide-js": "^2.15.3",
        "@mjackson/form-data-parser": "^0.9.1",
        "@prisma/adapter-pg": "^7.6.0",
        "@prisma/client": "7.6.0",
        "@react-email/components": "^1.0.11",
        "@react-pdf/renderer": "^4.3.3",
        "@react-router/node": "^7.14.0",
        "@react-router/serve": "^7.14.1",
        "@vis.gl/react-google-maps": "^1.8.2",
        "bullmq": "^5.73.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "csv": "^6.5.1",
        "dotenv": "^17.4.0",
        "exceljs": "^4.4.0",
        "ioredis": "^5.10.1",
        "isbot": "^5.1.37",
        "jszip": "^3.10.1",
        "lucide-react": "^1.8.0",
        "p-limit": "^7.3.0",
        "pdfjs-dist": "^5.6.205",
        "radix-ui": "^1.4.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router": "^7.14.1",
        "recharts": "^3.8.1",
        "resend": "^6.12.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.5.0",
        "tsx": "^4.21.0",
        "winston": "^3.19.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.12",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.59.1",
        "@react-email/preview-server": "5.2.10",
        "@react-router/dev": "^7.14.0",
        "@tailwindcss/vite": "^4.2.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^4.1.3",
        "eslint": "^10.2.1",
        "eslint-plugin-boundaries": "^6.0.2",
        "prisma": "^7.6.0",
        "react-email": "5.2.10",
        "shadcn": "^4.2.0",
        "tailwindcss": "^4.2.2",
        "typescript": "^6.0.2",
        "vite": "^8.0.5",
        "vitest": "^4.1.3"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@prisma/engines",
            "better-sqlite3",
            "esbuild",
            "prisma"
        ]
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24.11.0",
            "onFail": "error"
        },
        "packageManager": {
            "name": "pnpm",
            "version": "10.26.1",
            "onFail": "warn"
        }
    },
    "packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa"
}
