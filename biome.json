{
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    "files": {
        "ignoreUnknown": false,
        "includes": ["**"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space"
    },
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "useForOf": "error",
                "useShorthandAssign": "error",
                "useShorthandFunctionType": "error",
                "useNamingConvention": {
                    "level": "error",
                    "options": {
                        "strictCase": false,
                        "conventions": [
                            {
                                "selector": { "kind": "objectLiteralMember" },
                                "formats": [
                                    "camelCase",
                                    "PascalCase",
                                    "CONSTANT_CASE",
                                    "snake_case"
                                ]
                            }
                        ]
                    }
                },
                "useFragmentSyntax": "error",
                "useExponentiationOperator": "error",
                "noYodaExpression": "error",
                "noShoutyConstants": "info",
                "useConsistentArrayType": {
                    "level": "error",
                    "options": { "syntax": "shorthand" }
                },
                "useArrayLiterals": "error"
            },
            "suspicious": {
                "useAwait": "warn",
                "useErrorMessage": "warn",
                "noConsole": "error"
            },
            "performance": {
                "useTopLevelRegex": "error"
            },
            "correctness": {
                "useHookAtTopLevel": "error"
            },
            "complexity": {
                "noExcessiveCognitiveComplexity": "warn"
            },
            "nursery": {
                "useSortedClasses": "info"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "app/database/seed.ts",
                "app/database/seed-marketing.ts",
                "app/database/backfill-normalized.ts"
            ],
            "linter": {
                "rules": {
                    "style": { "useNamingConvention": "off" },
                    "suspicious": { "noConsole": "off" },
                    "complexity": { "noExcessiveCognitiveComplexity": "off" }
                }
            }
        },
        {
            "includes": ["**/*.server.ts", "app/shared/domain/**/*.ts"],
            "linter": {
                "rules": {
                    "style": { "useNamingConvention": "off" }
                }
            }
        },
        {
            "includes": ["app/features/**/routes/**/*.tsx", "app/root.tsx"],
            "linter": {
                "rules": {
                    "style": { "useNamingConvention": "off" }
                }
            }
        },
        {
            "includes": [
                "app/features/events/ui/ProgrammeDocument.tsx",
                "app/features/events/ui/ProgrammeBoardDocument.tsx",
                "app/features/territories/ui/TerritoryAttributionDocument.tsx"
            ],
            "linter": {
                "rules": {
                    "suspicious": { "noArrayIndexKey": "off" }
                }
            }
        },
        {
            "includes": [
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.integration.test.ts",
                "**/*.spec.ts"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useNamingConvention": "off",
                        "noNonNullAssertion": "off"
                    },
                    "correctness": { "useHookAtTopLevel": "off" }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "asNeeded",
            "bracketSpacing": true,
            "bracketSameLine": false,
            "arrowParentheses": "asNeeded",
            "lineWidth": 120
        }
    },
    "json": {
        "formatter": {
            "indentWidth": 4,
            "trailingCommas": "none"
        }
    },
    "graphql": {
        "formatter": {
            "indentWidth": 4
        }
    },
    "css": {
        "parser": {
            "cssModules": false,
            "tailwindDirectives": true
        },
        "linter": {
            "enabled": true
        }
    }
}
