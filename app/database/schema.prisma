// What a programme part *is*, and what it *can do* — a talk, a Sujet, a
// Watchtower study. Congregation-scoped and congregation-creatable.
//
// Deliberately carries no defaults. The three layers are:
//   PartPreset   — identity + capability: the reader slot, the slot labels,
//                  the external-speaker rule, the share message. Never
//                  overridable on a part.
//   TemplatePart — defaults (name, section, duration) so they aren't retyped.
//   EventPart    — the instance, free to override anything the template set.
//
// Eligibility — which roles may fill a slot — is deliberately NOT in that
// first layer, though it was until the 20260824 migration. Two parts of the
// same kind can be done by different roles depending on where they sit in the
// programme, so it belongs to the part. Only TemplatePart and EventPart carry
// allowedRoles; a new field goes here only if it is true of every occurrence
// of the kind.
//
// That split is why `shareMessage` lives here: the wording of the message sent
// to an assignee is a property of the kind of assignment, not of one evening's
// occurrence of it, so it must not be editable part by part.
model PartPreset {
  id    Int     @id @default(autoincrement())
  key   String
  // Null on a seeded kind means "use the built-in name for the current locale",
  // the same convention Role uses for its built-ins: a congregation that
  // renames one stores its own text, one that never does follows the catalogue
  // and switches language with the congregation.
  name  String?
  // 'part' | 'service' — which of the two assignment families this kind
  // applies to, so the picker on a service row never offers "Discours public".
  scope String  @default("part")

  // Capability. Fixed at part level, by design.
  hasReaderSlot        Boolean @default(false)
  speakerLabel         String?
  readerLabel          String?
  allowExternalSpeaker Boolean @default(false)

  // Body of the SMS/WhatsApp message shared with the assignee, written with
  // {{variable}} placeholders — see app/features/events/model/share-message.ts.
  //
  // Three states, and they mean different things. Null: use the built-in body
  // for the congregation's locale. Empty: deliberately no message, so the kind
  // has no share button. Text: the congregation's own wording.
  shareMessage String?

  // Seeded presets: `key` is immutable and the row cannot be deleted, matching
  // the isSystemTemplate() convention on EventTemplate.
  isSystem Boolean @default(false)

  templateParts        TemplatePart[]
  eventParts           EventPart[]
  templateServiceParts TemplateServicePart[]
  eventServiceParts    EventServicePart[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, congregationId])
  @@unique([id, congregationId])
  @@index([congregationId])
}

