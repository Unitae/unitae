generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum PublisherType {
  Normal              @map("normal")
  PionnierAuxiliaires @map("pionnier-auxiliaires")
  PionnierPermanant   @map("pionnier-permanant")
  PionnierSpecial     @map("pionnier-special")
  Missionnaire        @map("missionnaire")
}

enum TerritoryKind {
  Classical @map("doors-to-doors")
  Univ      @map("campus")
  Commerces @map("commerces")
  Phone     @map("phones")
  Hotel     @map("hotel")
}

enum EntranceKind {
  Residential @map("residential")
  Commerce    @map("commerce")
  Hotel       @map("hotel")
  Laundromat  @map("laundromat")
  Campus      @map("campus")
}

enum TerritoryAttributionKind {
  Default  @map("default")
  Phone    @map("phones")
  Campaign @map("campaign")
}

model Congregation {
  id               Int     @id @default(autoincrement())
  name             String
  slug             String  @unique
  domain           String? @unique
  displayName      String?
  emailFromName    String?
  emailFromAddress String?
  baseUrl          String?
  locale           String  @default("fr")
  timezone         String  @default("Europe/Paris")
  active           Boolean @default(true)

  // Plan & limits (null = unlimited, written by control plane)
  plan              String?
  maxPublishers     Int?
  maxTerritories    Int?
  maxUsers          Int?
  maxStorageBytes   BigInt?
  maxBoardDocuments Int?
  maxCardOverlays   Int?
  trialEndsAt       DateTime?
  suspendedAt       DateTime?
  suspendedReason   String?

  // Stripe references (only used by control plane)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  userAccounts                 UserAccount[]
  members                      Member[]
  memberRoleAssignments        MemberRoleAssignment[]
  territories                  Territory[]
  buildings                    Building[]
  buildingEntrances            BuildingEntrance[]
  attributions                 Attribution[]
  publisherGroups              PublisherGroup[]
  publisherActivities          PublisherActivity[]
  pioneerGoals                 PioneerGoal[]
  pioneerEnrolments            PioneerEnrolment[]
  boardSections                BoardSection[]
  boardSectionVisibilityRoles  BoardSectionVisibilityRole[]
  boardDocuments               BoardDocument[]
  boardDocumentVersions        BoardDocumentVersion[]
  boardDynamicDocumentSettings BoardDynamicDocumentSettings[]
  events                       Event[]
  settings                     Setting[]
  userPermissions              CongregationUserPermission[]
  roles                        Role[]
  rolePermissions              RolePermission[]
  userRoleAssignments          UserRoleAssignment[]
  buildingAccesses             BuildingAccess[]
  buildingResidentialData      BuildingResidentialData[]
  dataDeletionRecords          DataDeletionRecord[]
  consentRecords               ConsentRecord[]
  auditLogs                    AuditLog[]

  eventTemplates                  EventTemplate[]
  templateParts                   TemplatePart[]
  templateServiceParts            TemplateServicePart[]
  eventParts                      EventPart[]
  eventServiceParts               EventServicePart[]
  templateResponsibles            TemplateResponsible[]
  templatePartAllowedRoles        TemplatePartAllowedRole[]
  eventPartAllowedRoles           EventPartAllowedRole[]
  templateServicePartAllowedRoles TemplateServicePartAllowedRole[]
  eventServicePartAllowedRoles    EventServicePartAllowedRole[]
  externalSpeakers                           ExternalSpeaker[]

  emergencyContacts EmergencyContact[]

  notificationEvents      NotificationEvent[]
  notificationPreferences NotificationPreference[]

  territoryCardOverlays TerritoryCardOverlay[]
  territoryPerimeter    TerritoryPerimeter?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A person currently part of this congregation. Holds identity, demographics,
// publisher status, and the lifecycle flags (`leftAt` for soft-leave,
// `anonymizedAt` for GDPR scrub).
//
// All domain FKs (attributions, activity reports, programme assignments,
// publisher groups) point here. Account-bound FKs (audit, document uploads,
// tokens, permissions, management role assignments) point at `UserAccount`.
//
// A Member can exist without a UserAccount (offline publisher, ministry-school
// student). A UserAccount can exist without a Member (circuit overseer,
// external admin).
model Member {
  id             Int          @id @default(autoincrement())
  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  // Identity
  firstname           String
  lastname            String
  // Search aids: lowercased, diacritic-stripped copies of firstname/lastname.
  // Maintained at write-time so search queries can stay in pure Prisma without
  // needing the `unaccent` extension at runtime.
  firstnameNormalized String   @default("")
  lastnameNormalized  String   @default("")
  isMale              Boolean?
  birthDate           DateTime?
  phone               String   @default("")
  address             String   @default("")
  // Contact email — person data, distinct from the login email on UserAccount.
  // The two may match or differ; a member can have a contact email without a login.
  email               String   @default("")

  // Emergency preparedness. `dpaCardUpToDate` = the member holds an up-to-date
  // DPA card (directive médicale anticipée); `survivalBackpackReady` = their
  // survival backpack is ready. `emergencyContacts` are third parties to reach
  // about the member in a crisis (scrubbed on anonymize).
  dpaCardUpToDate       Boolean @default(false)
  survivalBackpackReady Boolean @default(false)

  // Domain status. `isPublisher = false` means ministry-school student.
  // `type` is only meaningful when `isPublisher = true`.
  isPublisher Boolean       @default(false)
  type        PublisherType @default(Normal)
  baptismDate DateTime?
  isAnointed  Boolean       @default(false)
  isHelder    Boolean       @default(false)
  isServant   Boolean       @default(false)

  // Group
  publisherGroupId Int?
  publisherGroup   PublisherGroup? @relation("group", fields: [publisherGroupId], references: [id])
  responsibleFor   PublisherGroup? @relation("groupResponsible")
  deputyFor        PublisherGroup? @relation("groupDeputy")

  // Lifecycle. Three orthogonal dimensions:
  //   leftAt        — soft-leave; reversible. Hides Member from publisher-facing lists.
  //   inactiveAt    — publisher hasn't preached for 6 consecutive monthly reports. Hides them
  //                   from public display-board surfaces (groups, pioneers) and from active-publisher
  //                   stats. Auto-set by evaluateInactiveStatus on activity writes; cleared when an
  //                   hours report arrives. Reversible; can also be set manually by a publisher manager.
  //   anonymizedAt  — GDPR scrub; irreversible. PII fields cleared, activity rows preserved.
  leftAt       DateTime?
  inactiveAt   DateTime?
  anonymizedAt DateTime?

  // Optional 1:1 to a login account
  account UserAccount?

  // Domain relations (FK target Member.id)
  attributions             Attribution[]                    @relation("publisher")
  activities               PublisherActivity[]              @relation("publisherActivity")
  pioneerEnrolments        PioneerEnrolment[]
  eventPartsAsAssignee        EventPart[]        @relation("partAssignee")
  eventPartsAsAssistant       EventPart[]        @relation("partAssistant")
  eventServicePartsAsAssignee EventServicePart[] @relation("servicePartAssignee")

  // Identity-role assignments (built-in roles like brother/elder/pioneer plus
  // any custom role the user may add later that expresses identity)
  roleAssignments MemberRoleAssignment[]

  emergencyContacts EmergencyContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, congregationId])
  @@index([congregationId, leftAt])
  @@index([congregationId, firstnameNormalized])
  @@index([congregationId, lastnameNormalized])
}

// A person to contact about a Member in an emergency — either to get
// information about the Member's situation or to pass information on. Holds
// third-party PII (name + phone), so it is purged when the Member is
// anonymized. Owned by the Member; no invariants of its own.
model EmergencyContact {
  id           Int    @id @default(autoincrement())
  // biome-ignore lint/style/useNamingConvention: Prisma composite FK
  member       Member @relation(fields: [memberId, congregationId], references: [id, congregationId], onDelete: Cascade)
  memberId     Int
  name         String
  relationship String @default("") // free text: ami, famille, enfant, conjoint…
  phone        String @default("")

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  createdAt DateTime @default(now())

  @@unique([id, congregationId])
  @@index([congregationId])
  @@index([memberId, congregationId])
}

// A login. Always has an email + password. Optionally points at a Member.
//
// When `memberId` is null, the account belongs to a circuit overseer or
// external admin who is not part of this congregation. The display
// `firstname` / `lastname` fields are used in that case; when `memberId`
// is set, name comes from the linked Member.
//
// Note: AuditLog.actorId, NotificationEvent.{actorId,recipientId} are loose
// `Int?` fields without FK constraints; their semantic target is UserAccount.id.
model UserAccount {
  id             Int          @id @default(autoincrement())
  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId Int?    @unique

  // Display fallback. Only used when `memberId` is null. When linked to a
  // Member, these stay null and the Member's name is the source of truth.
  firstname String?
  lastname  String?

  email           String    @unique
  password        String
  active          Boolean   @default(true)
  emailVerifiedAt DateTime?
  platformAdmin   Boolean   @default(false)
  anonymizedAt    DateTime?

  // Session epoch. Embedded in the session cookie when a session is established and
  // compared on every request in verifySession. Incremented on password change/reset
  // and on admin invalidation to revoke all previously-issued sessions ("log out everywhere").
  sessionEpoch    Int       @default(0)

  // Optional TOTP two-factor authentication.
  // twoFactorSecret holds the AES-256-GCM ciphertext of the base32 seed (null = never enrolled).
  // twoFactorEnabledAt is null while enrollment is pending (secret generated, not yet confirmed)
  // and set once confirmed — only then is the login challenge armed.
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?

  // Account-bound relations
  congregationPermissions  CongregationUserPermission[]
  roleAssignments          UserRoleAssignment[] // management/access roles
  eventsCreated            Event[]                        @relation("createdBy")
  documentsViewed          BoardDocument[]                @relation("viewedBy")
  documentVersionUploads   BoardDocumentVersion[]         @relation("boardDocumentVersionUploader")
  dynamicDocumentViews     BoardDynamicDocumentView[]
  templateResponsibilities TemplateResponsible[] @relation("templateResponsible")
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  calendarFeedTokens       CalendarFeedToken[]
  consentRecords           ConsentRecord[]
  notificationPreferences  NotificationPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, congregationId])
}

model Permission {
  id                      Int                          @id @default(autoincrement())
  key                     String                       @unique
  congregationPermissions CongregationUserPermission[]
  rolePermissions         RolePermission[]
}

model Role {
  id          Int     @id @default(autoincrement())
  key         String
  name        String?
  description String?
  isBuiltIn   Boolean @default(false)

  permissions       RolePermission[]
  members           UserRoleAssignment[]
  memberAssignments MemberRoleAssignment[]

  allowedForTemplateParts         TemplatePartAllowedRole[]
  allowedForEventParts            EventPartAllowedRole[]
  allowedForTemplateServiceParts  TemplateServicePartAllowedRole[]
  allowedForEventServiceParts     EventServicePartAllowedRole[]
  allowedForBoardSections          BoardSectionVisibilityRole[]

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, congregationId])
  @@unique([id, congregationId])
}

model RolePermission {
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId   Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([roleId, permissionId])
  @@index([congregationId])
  @@index([permissionId])
}

// Management/access role assignments (e.g. Roles Manager, Territory Manager).
// Granted manually by a Roles Manager. Permissions resolve through
// `UserRoleAssignment` → `Role` → `RolePermission`.
model UserRoleAssignment {
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([userId, roleId])
  @@index([congregationId])
  @@index([roleId])
}

// Identity role assignments (e.g. brother, elder, pioneer, publisher).
// Auto-synced from Member flags by `syncBuiltInRoleAssignments`. Permissions
// reach the linked UserAccount through this table too — every reader that
// resolves an account's permissions or role membership must union this with
// UserRoleAssignment. The canonical primitives live in
// app/shared/auth/permissions.server.ts.
model MemberRoleAssignment {
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       Int
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([memberId, roleId])
  @@index([congregationId])
  @@index([roleId])
}

model CongregationUserPermission {
  id             Int          @id @default(autoincrement())
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId   Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@unique([userId, permissionId, congregationId])
  @@unique([id, congregationId])
}

model BoardSection {
  id               Int                            @id @default(autoincrement())
  name             String
  order            Int?
  documents        BoardDocument[]
  dynamicDocuments BoardDynamicDocumentSettings[]
  visibilityRoles  BoardSectionVisibilityRole[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BoardSectionVisibilityRole {
  section        BoardSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId      Int
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([sectionId, roleId])
  @@index([roleId])
  @@index([congregationId])
}

model BoardDocument {
  id            Int                    @id @default(autoincrement())
  title         String
  uri           String?
  thumbnailUri  String?
  section       BoardSection           @relation(fields: [sectionId], references: [id])
  sectionId     Int
  order         Int?
  type          String?
  visibleFrom   DateTime?
  visibleUntil  DateTime?
  viewedBy      UserAccount[]          @relation("viewedBy")
  isHighlighted Boolean                @default(false)
  createdAt     DateTime               @default(now())
  versions      BoardDocumentVersion[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BoardDocumentVersion {
  id            Int           @id @default(autoincrement())
  document      BoardDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    Int
  uri           String
  thumbnailUri  String?
  versionNumber Int           @default(1)
  uploadedBy    UserAccount?  @relation("boardDocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById  Int?
  createdAt     DateTime      @default(now())

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BoardDynamicDocumentSettings {
  id            Int                        @id @default(autoincrement())
  title         String
  dynamicType   String
  dynamicRef    String?
  dynamicConfig Json?
  section       BoardSection               @relation(fields: [sectionId], references: [id])
  sectionId     Int
  order         Int?
  visibleFrom   DateTime?
  visibleUntil  DateTime?
  isHighlighted Boolean                    @default(false)
  showServices  Boolean                    @default(false)
  createdAt     DateTime                   @default(now())
  views         BoardDynamicDocumentView[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BoardDynamicDocumentView {
  id         Int                          @id @default(autoincrement())
  settings   BoardDynamicDocumentSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  settingsId Int
  user       UserAccount                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  viewedAt   DateTime                     @default(now())

  @@unique([settingsId, userId])
}

model Territory {
  id           Int                @id @default(autoincrement())
  number       String
  type         TerritoryKind      @default(Classical)
  notes        String             @default("")
  attributions Attribution[]      @relation("territory")
  entrances    BuildingEntrance[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model TerritoryPerimeter {
  id        Int      @id @default(autoincrement())
  paths     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int          @unique

  @@unique([id, congregationId])
}

model TerritoryCardOverlay {
  id        Int      @id @default(autoincrement())
  name      String?
  color     String
  paths     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@unique([id, congregationId])
  @@index([congregationId])
}

model Attribution {
  id          Int                      @id @default(autoincrement())
  type        TerritoryAttributionKind @default(Default)
  publisher   Member                   @relation("publisher", fields: [publisherId], references: [id])
  territory   Territory                @relation("territory", fields: [territoryId], references: [id])
  publisherId Int
  territoryId Int
  startDate   DateTime                 @default(now())
  endDate     DateTime?
  lateDate    DateTime
  notes       String                   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BuildingEntrance {
  id          Int         @id @default(autoincrement())
  territories Territory[]
  buildings   Building[]

  kind     EntranceKind @default(Residential)
  shopKind String       @default("")

  // Materialized aggregates for residential entrances (sum of BuildingResidentialData)
  homes    Int?
  phones   Int?
  liberals Int?

  // Centroid of the entrance's buildings; recomputed on building add/remove and on building coord change
  latitude  Float?
  longitude Float?

  access        Int?
  accesses      BuildingAccess[]
  isPMR         Boolean?
  isOpenEarly   Boolean?
  isMailboxOpen Boolean?

  residentialData BuildingResidentialData[]

  notes String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([congregationId, latitude, longitude])
}

model BuildingAccess {
  id         Int              @id @default(autoincrement())
  entrance   BuildingEntrance @relation(fields: [entranceId], references: [id], onDelete: Cascade)
  entranceId Int
  type       Int
  position   Int

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int
}

model BuildingResidentialData {
  id         Int              @id @default(autoincrement())
  building   Building         @relation(fields: [buildingId], references: [id])
  buildingId Int              @unique
  entrance   BuildingEntrance @relation(fields: [entranceId], references: [id], onDelete: Cascade)
  entranceId Int

  homes    Int?
  phones   Int?
  liberals Int?

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int
}

model Building {
  id               Int     @id @default(autoincrement())
  number           String
  street           String
  // Search aid: lowercased, diacritic-stripped copy of street.
  // Maintained at write-time so search queries can stay in pure Prisma.
  streetNormalized String  @default("")
  zip              String
  latitude         Float?
  longitude        Float?
  active      Boolean  @default(true)
  inTerritory Boolean  @default(true)
  inOpenData  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prospectionDate DateTime?
  entrances       BuildingEntrance[]
  residentialData BuildingResidentialData?

  notes          String @default("")
  importantNotes String @default("")

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([number, street, zip, congregationId], name: "address")
  @@unique([id, congregationId])
  @@index([congregationId, streetNormalized])
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String
  value String

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([key, congregationId])
  @@unique([id, congregationId])
}

model PublisherGroup {
  id            Int    @id @default(autoincrement())
  name          String
  adress        String
  members       Member[] @relation("group")
  responsible   Member   @relation("groupResponsible", fields: [responsibleId], references: [id])
  responsibleId Int      @unique
  deputy        Member?  @relation("groupDeputy", fields: [deputyId], references: [id])
  deputyId      Int?     @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model PublisherActivity {
  id          Int  @id @default(autoincrement())
  month       Int
  year        Int
  publisher   Member @relation("publisherActivity", fields: [publisherId], references: [id])
  publisherId Int

  hours       Int?
  studies     Int           @default(0)
  type        PublisherType @default(Normal)
  isPublisher Boolean       @default(false)
  notes       String        @default("")

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([publisherId, month, year], name: "activityId")
}

// Per-service-year hour goal for a pioneer type. A missing row falls back to the
// built-in default rate (see pioneer-goals.constants.ts); the control plane never
// writes this — congregation admins set overrides per year.
model PioneerGoal {
  id           Int           @id @default(autoincrement())
  serviceYear  Int
  type         PublisherType
  monthlyHours Int

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceYear, type, congregationId])
  @@unique([id, congregationId])
  @@index([congregationId, serviceYear])
}

// Explicit pioneer enrolment — the *plan* half of the plan/actual split (actual =
// PublisherActivity). One record per stint: who, which pioneer type, over what month
// range, at what per-person monthly goal. Source of truth for pace, replacing the
// per-month `type`-snapshot inference. See docs/development/specs/pioneer-enrolment.md.
model PioneerEnrolment {
  id       Int           @id @default(autoincrement())
  member   Member        @relation(fields: [memberId, congregationId], references: [id, congregationId], onDelete: Cascade)
  memberId Int
  type     PublisherType // a pioneer type, never Normal (enforced at the Zod boundary)

  // Inclusive month range, 0-indexed month + calendar year. A continuous stint may span
  // service-year boundaries. endMonth/endYear are null together (ongoing) or set together
  // (closed) — see the end_bounds_paired CHECK constraint in the migration. Auxiliary is
  // either single-month (monthly auxiliary, start == end) or ongoing (permanent auxiliary,
  // no end); annual types are ongoing until closed.
  startMonth Int
  startYear  Int
  endMonth   Int?
  endYear    Int?

  monthlyGoal Int? // null = fall back to PioneerGoal(serviceYear, type) → built-in default

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, congregationId])
  @@index([congregationId])
  @@index([memberId, congregationId])
}

model Event {
  id          Int        @id @default(autoincrement())
  name        String
  description String     @default("")
  startDate   DateTime
  endDate     DateTime
  status      String     @default("draft")

  template   EventTemplate? @relation("templateEvents", fields: [templateId], references: [id])
  templateId Int?

  eventParts        EventPart[]
  eventServiceParts EventServicePart[]

  createdBy   UserAccount @relation("createdBy", fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model EventTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  key         String
  description String  @default("")
  weekDay     Int?
  isRecurring Boolean @default(true)
  startTime   String  @default("19:00")
  endTime     String  @default("21:00")
  color       String  @default("#cfcfcf")

  parts        TemplatePart[]
  serviceParts TemplateServicePart[]
  events       Event[]                        @relation("templateEvents")
  responsibles TemplateResponsible[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, congregationId])
  @@unique([id, congregationId])
}

model TemplatePart {
  id                   Int     @id @default(autoincrement())
  name                 String
  section              String  @default("")
  track                String  @default("")
  trackOrder           Int?
  order                Int
  durationMin          Int?
  allowExternalSpeaker Boolean @default(false)
  // Per-part display labels for the two role slots. Null means "use the
  // generic i18n default" — see app/features/events/model/part-labels.ts.
  speakerLabel         String?
  readerLabel          String?

  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int

  eventParts   EventPart[]
  allowedRoles TemplatePartAllowedRole[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model TemplateServicePart {
  id   Int    @id @default(autoincrement())
  name String
  key  String

  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int

  eventServiceParts EventServicePart[]
  allowedRoles      TemplateServicePartAllowedRole[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model EventPart {
  id          Int     @id @default(autoincrement())
  topic       String  @default("")
  note        String  @default("")
  hasConflict Boolean @default(false)

  // Inline fields (copied from template part on generation, or set manually for custom parts)
  name         String  @default("")
  section      String  @default("")
  track        String  @default("")
  trackOrder   Int?
  order        Int     @default(0)
  durationMin  Int?
  // Per-part display labels for the two role slots. Denormalized from the
  // template at apply time so historical assignments stay stable when the
  // template later changes. Null → i18n default (part-labels.ts helper).
  speakerLabel String?
  readerLabel  String?

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  part   TemplatePart? @relation(fields: [partId], references: [id], onDelete: SetNull)
  partId Int?

  assignee   Member? @relation("partAssignee", fields: [assigneeId], references: [id])
  assigneeId Int?

  assistant   Member? @relation("partAssistant", fields: [assistantId], references: [id])
  assistantId Int?

  allowExternalSpeaker Boolean @default(false)

  externalSpeaker   ExternalSpeaker? @relation(fields: [externalSpeakerId], references: [id], onDelete: SetNull)
  externalSpeakerId Int?

  allowedRoles EventPartAllowedRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([externalSpeakerId])
}

model ExternalSpeaker {
  id               Int       @id @default(autoincrement())
  name             String
  congregationName String    @default("")
  phone            String?
  email            String?
  notes            String?
  archivedAt       DateTime?

  eventParts EventPart[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([congregationId, archivedAt])
}

model EventServicePart {
  id          Int     @id @default(autoincrement())
  note        String  @default("")
  hasConflict Boolean @default(false)

  // Inline field (copied from template service part on generation, or set manually)
  name String @default("")

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  servicePart   TemplateServicePart? @relation(fields: [servicePartId], references: [id], onDelete: SetNull)
  servicePartId Int?

  assignee   Member? @relation("servicePartAssignee", fields: [assigneeId], references: [id])
  assigneeId Int?

  allowedRoles EventServicePartAllowedRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model TemplatePartAllowedRole {
  part   TemplatePart @relation(fields: [partId], references: [id], onDelete: Cascade)
  partId Int
  role   Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId Int
  asKind String

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([partId, roleId, asKind])
  @@index([roleId])
  @@index([congregationId])
}

model EventPartAllowedRole {
  eventPart   EventPart @relation(fields: [eventPartId], references: [id], onDelete: Cascade)
  eventPartId Int
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId      Int
  asKind      String

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([eventPartId, roleId, asKind])
  @@index([roleId])
  @@index([congregationId])
}

model TemplateServicePartAllowedRole {
  servicePart   TemplateServicePart @relation(fields: [servicePartId], references: [id], onDelete: Cascade)
  servicePartId Int
  role          Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId        Int

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([servicePartId, roleId])
  @@index([roleId])
  @@index([congregationId])
}

model EventServicePartAllowedRole {
  eventServicePart   EventServicePart @relation(fields: [eventServicePartId], references: [id], onDelete: Cascade)
  eventServicePartId Int
  role               Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId             Int

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([eventServicePartId, roleId])
  @@index([roleId])
  @@index([congregationId])
}

model TemplateResponsible {
  id Int @id @default(autoincrement())

  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int

  user   UserAccount @relation("templateResponsible", fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([templateId, congregationId])
  @@unique([id, congregationId])
}

model PasswordResetToken {
  id        Int         @id @default(autoincrement())
  token     String      @unique
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  createdAt DateTime    @default(now())
}

model EmailVerificationToken {
  id        Int         @id @default(autoincrement())
  token     String      @unique
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  createdAt DateTime    @default(now())
}

model CalendarFeedToken {
  id         Int         @id @default(autoincrement())
  token      String      @unique
  user       UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int         @unique
  createdAt  DateTime    @default(now())
  lastUsedAt DateTime?
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String?
  entityId   Int?
  actorId    Int?
  actorEmail String?
  metadata   String?
  createdAt  DateTime @default(now())

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@index([congregationId, createdAt])
  @@index([actorId])
  @@index([action])
}

model DataDeletionRecord {
  id          Int       @id @default(autoincrement())
  entityType  String
  entityId    Int
  requestedBy String
  requestedAt DateTime  @default(now())
  completedAt DateTime?

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model ConsentRecord {
  id             Int       @id @default(autoincrement())
  purpose        String
  consentedAt    DateTime  @default(now())
  withdrawnAt    DateTime?
  consentVersion String
  ipAddress      String?

  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model NotificationEvent {
  id            Int       @id @default(autoincrement())
  type          String
  status        String    @default("pending")
  entityType    String
  entityId      Int
  recipientId   Int?
  recipientRole String?
  actorId       Int?
  payload       String    @default("{}")
  debounceKey   String
  debounceUntil DateTime?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([status, debounceUntil])
  @@index([debounceKey, status])
  @@index([congregationId, status])
}

model NotificationPreference {
  id               Int     @id @default(autoincrement())
  notificationType String
  enabled          Boolean @default(true)

  user   UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([userId, notificationType, congregationId])
  @@unique([id, congregationId])
}
