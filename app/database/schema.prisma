generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum PublisherType {
  Normal              @map("normal")
  PionnierAuxiliaires @map("pionnier-auxiliaires")
  PionnierPermanant   @map("pionnier-permanant")
  PionnierSpecial     @map("pionnier-special")
  Missionnaire        @map("missionnaire")
}

enum TerritoryKind {
  Classical @map("doors-to-doors")
  Univ      @map("campus")
  Commerces @map("commerces")
  Phone     @map("phones")
  Hotel     @map("hotel")
}

enum EntranceKind {
  Residential @map("residential")
  Commerce    @map("commerce")
  Hotel       @map("hotel")
  Laundromat  @map("laundromat")
  Campus      @map("campus")
}

enum TerritoryAttributionKind {
  Default  @map("default")
  Phone    @map("phones")
  Campaign @map("campaign")
}

model Congregation {
  id              Int     @id @default(autoincrement())
  name            String
  slug            String  @unique
  domain          String? @unique
  displayName     String?
  emailFromName   String?
  emailFromAddress String?
  baseUrl         String?
  locale          String  @default("fr")
  timezone        String  @default("Europe/Paris")
  active          Boolean @default(true)

  // Plan & limits (null = unlimited, written by control plane)
  plan              String?
  maxPublishers     Int?
  maxTerritories    Int?
  maxUsers          Int?
  maxStorageBytes   BigInt?
  maxBoardDocuments Int?
  maxCardOverlays   Int?
  trialEndsAt       DateTime?
  suspendedAt       DateTime?
  suspendedReason   String?

  // Stripe references (only used by control plane)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  users              User[]
  territories        Territory[]
  buildings          Building[]
  buildingEntrances  BuildingEntrance[]
  attributions       Attribution[]
  publisherGroups    PublisherGroup[]
  publisherActivities PublisherActivity[]
  boardSections      BoardSection[]
  boardDocuments                BoardDocument[]
  boardDocumentVersions         BoardDocumentVersion[]
  boardDynamicDocumentSettings  BoardDynamicDocumentSettings[]
  events                        Event[]
  eventKinds         EventKind[]
  settings           Setting[]
  userRoles               CongregationUserRole[]
  buildingAccesses        BuildingAccess[]
  buildingResidentialData BuildingResidentialData[]
  dataDeletionRecords     DataDeletionRecord[]
  consentRecords          ConsentRecord[]
  auditLogs               AuditLog[]

  programmeTemplates              ProgrammeTemplate[]
  programmeTemplateParts          ProgrammeTemplatePart[]
  programmeTemplateServiceRoles   ProgrammeTemplateServiceRole[]
  programmePartAssignments        ProgrammePartAssignment[]
  programmeServiceRoleAssignments ProgrammeServiceRoleAssignment[]
  programmeTemplateResponsibles   ProgrammeTemplateResponsible[]
  externalSpeakers                ExternalSpeaker[]

  notificationEvents      NotificationEvent[]
  notificationPreferences NotificationPreference[]

  territoryCardOverlays TerritoryCardOverlay[]
  territoryPerimeter    TerritoryPerimeter?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        Int        @id @default(autoincrement())
  firstname String?
  lastname  String?
  email     String     @unique
  password  String
  active        Boolean    @default(true)
  platformAdmin Boolean    @default(false)
  congregationRoles CongregationUserRole[]

  isPublisher Boolean       @default(false)
  type        PublisherType @default(Normal)
  isMale      Boolean?
  phone       String?
  address     String?
  birthDate   DateTime?
  baptismDate DateTime?
  isHelder    Boolean   @default(false)
  isServant   Boolean   @default(false)
  isAnointed  Boolean   @default(false)

  emailVerifiedAt DateTime?
  anonymizedAt    DateTime?

  publisherGroupId Int?
  publisherGroup   PublisherGroup? @relation("group", fields: [publisherGroupId], references: [id])
  responsibleFor   PublisherGroup? @relation("groupResponsible")
  deputyFor        PublisherGroup? @relation("groupDeputy")

  attributions  Attribution[]       @relation("publisher")
  activities    PublisherActivity[] @relation("publisherActivity")
  eventsCreated Event[]             @relation("createdBy")

  partAssignments          ProgrammePartAssignment[]        @relation("partAssignee")
  partAssistantAssignments ProgrammePartAssignment[]        @relation("partAssistant")
  serviceRoleAssignments   ProgrammeServiceRoleAssignment[] @relation("serviceRoleAssignee")
  templateResponsibilities ProgrammeTemplateResponsible[]   @relation("templateResponsible")

  documentsViewed           BoardDocument[]            @relation("viewedBy")
  documentVersionUploads    BoardDocumentVersion[]     @relation("boardDocumentVersionUploader")
  dynamicDocumentViews      BoardDynamicDocumentView[]
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  calendarFeedTokens         CalendarFeedToken[]
  consentRecords          ConsentRecord[]
  notificationPreferences NotificationPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model UserRole {
  id          Int    @id @default(autoincrement())
  key         String @unique
  description String @default("")
  congregationRoles CongregationUserRole[]
}

model CongregationUserRole {
  id             Int          @id @default(autoincrement())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  role           UserRole     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@unique([userId, roleId, congregationId])
  @@unique([id, congregationId])
}

model BoardSection {
  id               Int                            @id @default(autoincrement())
  name             String
  order            Int?
  documents        BoardDocument[]
  dynamicDocuments BoardDynamicDocumentSettings[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BoardDocument {
  id            Int          @id @default(autoincrement())
  title         String
  uri           String?
  thumbnailUri  String?
  section       BoardSection @relation(fields: [sectionId], references: [id])
  sectionId     Int
  order         Int?
  type          String?
  visibleFrom   DateTime?
  visibleUntil  DateTime?
  viewedBy      User[]       @relation("viewedBy")
  isHighlighted Boolean      @default(false)
  createdAt     DateTime     @default(now())
  versions      BoardDocumentVersion[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BoardDocumentVersion {
  id            Int           @id @default(autoincrement())
  document      BoardDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    Int
  uri           String
  thumbnailUri  String?
  versionNumber Int           @default(1)
  uploadedBy    User?         @relation("boardDocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById  Int?
  createdAt     DateTime      @default(now())

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BoardDynamicDocumentSettings {
  id            Int          @id @default(autoincrement())
  title         String
  dynamicType   String
  dynamicRef    String?
  dynamicConfig Json?
  section       BoardSection @relation(fields: [sectionId], references: [id])
  sectionId     Int
  order         Int?
  visibleFrom   DateTime?
  visibleUntil  DateTime?
  isHighlighted Boolean      @default(false)
  showServices  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  views         BoardDynamicDocumentView[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BoardDynamicDocumentView {
  id         Int                          @id @default(autoincrement())
  settings   BoardDynamicDocumentSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  settingsId Int
  user       User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  viewedAt   DateTime                     @default(now())

  @@unique([settingsId, userId])
}

model Territory {
  id           Int                @id @default(autoincrement())
  number       String
  type         TerritoryKind      @default(Classical)
  notes        String             @default("")
  attributions Attribution[]      @relation("territory")
  entrances    BuildingEntrance[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model TerritoryPerimeter {
  id        Int      @id @default(autoincrement())
  paths     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int          @unique
}

model TerritoryCardOverlay {
  id        Int      @id @default(autoincrement())
  name      String?
  color     String
  paths     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@index([congregationId])
}

model Attribution {
  id          Int       @id @default(autoincrement())
  type        TerritoryAttributionKind @default(Default)
  publisher   User      @relation("publisher", fields: [publisherId], references: [id])
  territory   Territory @relation("territory", fields: [territoryId], references: [id])
  publisherId Int
  territoryId Int
  startDate   DateTime  @default(now())
  endDate     DateTime?
  lateDate    DateTime
  notes       String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BuildingEntrance {
  id          Int         @id @default(autoincrement())
  territories Territory[]
  buildings   Building[]

  kind     EntranceKind @default(Residential)
  shopKind String @default("")

  // Materialized aggregates for residential entrances (sum of BuildingResidentialData)
  homes    Int?
  phones   Int?
  liberals Int?

  // Centroid of the entrance's buildings; recomputed on building add/remove and on building coord change
  latitude  Float?
  longitude Float?

  access        Int?
  accesses      BuildingAccess[]
  isPMR         Boolean?
  isOpenEarly   Boolean?
  isMailboxOpen Boolean?

  residentialData BuildingResidentialData[]

  notes String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([congregationId, latitude, longitude])
}

model BuildingAccess {
  id         Int              @id @default(autoincrement())
  entrance   BuildingEntrance @relation(fields: [entranceId], references: [id], onDelete: Cascade)
  entranceId Int
  type       Int
  position   Int

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int
}

model BuildingResidentialData {
  id         Int              @id @default(autoincrement())
  building   Building         @relation(fields: [buildingId], references: [id])
  buildingId Int              @unique
  entrance   BuildingEntrance @relation(fields: [entranceId], references: [id], onDelete: Cascade)
  entranceId Int

  homes    Int?
  phones   Int?
  liberals Int?

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int
}

model Building {
  id          Int      @id @default(autoincrement())
  number      String
  street      String
  zip         String
  latitude    Float?
  longitude   Float?
  active      Boolean  @default(true)
  inTerritory Boolean  @default(true)
  inOpenData  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prospectionDate DateTime?
  entrances       BuildingEntrance[]
  residentialData BuildingResidentialData?

  notes          String @default("")
  importantNotes String @default("")

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([number, street, zip, congregationId], name: "address")
  @@unique([id, congregationId])
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String
  value String

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([key, congregationId])
  @@unique([id, congregationId])
}

model PublisherGroup {
  id            Int    @id @default(autoincrement())
  name          String
  adress        String
  members       User[] @relation("group")
  responsible   User   @relation("groupResponsible", fields: [responsibleId], references: [id])
  responsibleId Int    @unique
  deputy        User?  @relation("groupDeputy", fields: [deputyId], references: [id])
  deputyId      Int?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model PublisherActivity {
  id          Int  @id @default(autoincrement())
  month       Int
  year        Int
  publisher   User @relation("publisherActivity", fields: [publisherId], references: [id])
  publisherId Int

  hours       Int?
  studies     Int           @default(0)
  type        PublisherType @default(Normal)
  isPublisher Boolean       @default(false)
  notes       String  @default("")

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@index([publisherId, month, year], name: "activityId")
  @@unique([id, congregationId])
}

model Event {
  id          Int        @id @default(autoincrement())
  name        String
  description String     @default("")
  kind        EventKind? @relation("kind", fields: [kindId], references: [id])
  kindId      Int?
  startDate   DateTime
  endDate     DateTime

  template   ProgrammeTemplate? @relation("templateEvents", fields: [templateId], references: [id])
  templateId Int?

  partAssignments        ProgrammePartAssignment[]
  serviceRoleAssignments ProgrammeServiceRoleAssignment[]

  createdBy   User     @relation("createdBy", fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model EventKind {
  id      Int    @id @default(autoincrement())
  name    String
  key     String
  color   String
  weekDay Int?

  events    Event[]             @relation("kind")
  templates ProgrammeTemplate[] @relation("templateKind")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([key, congregationId])
  @@unique([id, congregationId])
}

model ProgrammeTemplate {
  id          Int     @id @default(autoincrement())
  name        String
  key         String
  description String  @default("")
  weekDay     Int?
  isRecurring Boolean @default(true)

  kind   EventKind? @relation("templateKind", fields: [kindId], references: [id])
  kindId Int?

  parts        ProgrammeTemplatePart[]
  serviceRoles ProgrammeTemplateServiceRole[]
  events       Event[]                        @relation("templateEvents")
  responsibles ProgrammeTemplateResponsible[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, congregationId])
  @@unique([id, congregationId])
}

model ProgrammeTemplatePart {
  id          Int     @id @default(autoincrement())
  name        String
  section     String  @default("")
  track       String  @default("")
  trackOrder  Int?
  order       Int
  durationMin          Int?
  allowExternalSpeaker Boolean @default(false)

  template   ProgrammeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int

  assignments ProgrammePartAssignment[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model ProgrammeTemplateServiceRole {
  id   Int    @id @default(autoincrement())
  name String
  key  String

  template   ProgrammeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int

  assignments ProgrammeServiceRoleAssignment[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model ProgrammePartAssignment {
  id          Int     @id @default(autoincrement())
  topic       String  @default("")
  note        String  @default("")
  hasConflict Boolean @default(false)

  // Inline fields (copied from template part on generation, or set manually for custom parts)
  name        String  @default("")
  section     String  @default("")
  track       String  @default("")
  trackOrder  Int?
  order       Int     @default(0)
  durationMin Int?

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  part   ProgrammeTemplatePart? @relation(fields: [partId], references: [id], onDelete: SetNull)
  partId Int?

  assignee   User? @relation("partAssignee", fields: [assigneeId], references: [id])
  assigneeId Int?

  assistant   User? @relation("partAssistant", fields: [assistantId], references: [id])
  assistantId Int?

  allowExternalSpeaker Boolean @default(false)

  externalSpeaker   ExternalSpeaker? @relation(fields: [externalSpeakerId], references: [id], onDelete: SetNull)
  externalSpeakerId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([externalSpeakerId])
}

model ExternalSpeaker {
  id               Int       @id @default(autoincrement())
  name             String
  congregationName String    @default("")
  phone            String?
  email            String?
  notes            String?
  archivedAt       DateTime?

  partAssignments ProgrammePartAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([congregationId, archivedAt])
}

model ProgrammeServiceRoleAssignment {
  id          Int     @id @default(autoincrement())
  note        String  @default("")
  hasConflict Boolean @default(false)

  // Inline field (copied from template service role on generation, or set manually)
  name String @default("")

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  serviceRole   ProgrammeTemplateServiceRole? @relation(fields: [serviceRoleId], references: [id], onDelete: SetNull)
  serviceRoleId Int?

  assignee   User? @relation("serviceRoleAssignee", fields: [assigneeId], references: [id])
  assigneeId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model ProgrammeTemplateResponsible {
  id Int @id @default(autoincrement())

  template   ProgrammeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId Int

  user   User @relation("templateResponsible", fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([templateId, congregationId])
  @@unique([id, congregationId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model CalendarFeedToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int       @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  action         String
  entityType     String?
  entityId       Int?
  actorId        Int?
  actorEmail     String?
  metadata       String?
  createdAt      DateTime @default(now())

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@index([congregationId, createdAt])
  @@index([actorId])
  @@index([action])
}

model DataDeletionRecord {
  id             Int      @id @default(autoincrement())
  entityType     String
  entityId       Int
  requestedBy    String
  requestedAt    DateTime @default(now())
  completedAt    DateTime?

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model ConsentRecord {
  id             Int       @id @default(autoincrement())
  purpose        String
  consentedAt    DateTime  @default(now())
  withdrawnAt    DateTime?
  consentVersion String
  ipAddress      String?

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model NotificationEvent {
  id            Int       @id @default(autoincrement())
  type          String
  status        String    @default("pending")
  entityType    String
  entityId      Int
  recipientId   Int?
  recipientRole String?
  actorId       Int?
  payload       String    @default("{}")
  debounceKey   String
  debounceUntil DateTime?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@index([status, debounceUntil])
  @@index([debounceKey, status])
  @@index([congregationId, status])
  @@unique([id, congregationId])
}

model NotificationPreference {
  id               Int     @id @default(autoincrement())
  notificationType String
  enabled          Boolean @default(true)

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([userId, notificationType, congregationId])
  @@unique([id, congregationId])
}
