generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum PublisherType {
  Normal              @map("normal")
  PionnierAuxiliaires @map("pionnier-auxiliaires")
  PionnierPermanant   @map("pionnier-permanant")
  PionnierSpecial     @map("pionnier-special")
  Missionnaire        @map("missionnaire")
}

// The key set of the built-in territory kinds. The `TerritoryKind` model is the
// entity; this enum still types `Territory.type` until territories move onto the FK.
enum TerritoryKindKey {
  Classical @map("doors-to-doors")
  Univ      @map("campus")
  Commerces @map("commerces")
  Phone     @map("phones")
  Hotel     @map("hotel")
}

enum EntranceKind {
  Residential @map("residential")
  Commerce    @map("commerce")
  Hotel       @map("hotel")
  Laundromat  @map("laundromat")
  Campus      @map("campus")
}

enum TerritoryAttributionKind {
  Default @map("default")
  Phone   @map("phones")
}

enum CampaignRegularStartAction {
  Pause @map("pause")
  Close @map("close")
  Leave @map("leave")
}

enum CampaignRegularEndAction {
  Resume     @map("resume")
  KeepPaused @map("keep-paused")
  Close      @map("close")
}

model Congregation {
  id               Int     @id @default(autoincrement())
  name             String
  slug             String  @unique
  domain           String? @unique
  displayName      String?
  emailFromName    String?
  emailFromAddress String?
  baseUrl          String?
  locale           String  @default("fr")
  timezone         String  @default("Europe/Paris")
  active           Boolean @default(true)

  // Plan & limits (null = unlimited, written by control plane)
  plan              String?
  maxPublishers     Int?
  maxTerritories    Int?
  maxUsers          Int?
  maxStorageBytes   BigInt?
  maxBoardDocuments Int?
  maxCardOverlays   Int?
  trialEndsAt       DateTime?
  suspendedAt       DateTime?
  suspendedReason   String?

  // Stripe references (only used by control plane)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  userAccounts                 UserAccount[]
  members                      Member[]
  memberRoleAssignments        MemberRoleAssignment[]
  territories                  Territory[]
  territoryKinds               TerritoryKind[]
  territoryKindAllowedRoles    TerritoryKindAllowedRole[]
  buildings                    Building[]
  buildingEntrances            BuildingEntrance[]
  attributions                 Attribution[]
  campaigns                    Campaign[]
  campaignTerritories          CampaignTerritory[]
  publisherGroups              PublisherGroup[]
  publisherActivities          PublisherActivity[]
  pioneerGoals                 PioneerGoal[]
  pioneerEnrolments            PioneerEnrolment[]
  boardSections                BoardSection[]
  boardSectionVisibilityRoles  BoardSectionVisibilityRole[]
  boardDocuments               BoardDocument[]
  boardDocumentVersions        BoardDocumentVersion[]
  boardDynamicDocumentSettings BoardDynamicDocumentSettings[]
  events                       Event[]
  settings                     Setting[]
  roles                        Role[]
  rolePermissions              RolePermission[]
  userRoleAssignments          UserRoleAssignment[]
  buildingAccesses             BuildingAccess[]
  buildingResidentialData      BuildingResidentialData[]
  dataDeletionRecords          DataDeletionRecord[]
  consentRecords               ConsentRecord[]
  auditLogs                    AuditLog[]

  eventTemplates                  EventTemplate[]
  templateParts                   TemplatePart[]
  templateServiceParts            TemplateServicePart[]
  eventParts                      EventPart[]
  eventServiceParts               EventServicePart[]
  templateResponsibles            TemplateResponsible[]
  templatePartAllowedRoles        TemplatePartAllowedRole[]
  eventPartAllowedRoles           EventPartAllowedRole[]
  templateServicePartAllowedRoles TemplateServicePartAllowedRole[]
  eventServicePartAllowedRoles    EventServicePartAllowedRole[]
  partPresets                     PartPreset[]
  externalSpeakers                ExternalSpeaker[]

  emergencyContacts EmergencyContact[]

  notificationEvents      NotificationEvent[]
  notificationPreferences NotificationPreference[]

  territoryCardOverlays TerritoryCardOverlay[]
  territoryPerimeter    TerritoryPerimeter?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A person currently part of this congregation. Holds identity, demographics,
// publisher status, and the lifecycle flags (`leftAt` for soft-leave,
// `anonymizedAt` for GDPR scrub).
//
// All domain FKs (attributions, activity reports, programme assignments,
// publisher groups) point here. Account-bound FKs (audit, document uploads,
// tokens, permissions, management role assignments) point at `UserAccount`.
//
// A Member can exist without a UserAccount (offline publisher, ministry-school
// student). A UserAccount can exist without a Member (circuit overseer,
// external admin).
model Member {
  id             Int          @id @default(autoincrement())
  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  // Identity
  firstname           String
  lastname            String
  // Search aids: lowercased, diacritic-stripped copies of firstname/lastname.
  // Maintained at write-time so search queries can stay in pure Prisma without
  // needing the `unaccent` extension at runtime.
  firstnameNormalized String    @default("")
  lastnameNormalized  String    @default("")
  isMale              Boolean?
  birthDate           DateTime?
  phone               String    @default("")
  address             String    @default("")
  // Contact email — person data, distinct from the login email on UserAccount.
  // The two may match or differ; a member can have a contact email without a login.
  email               String    @default("")

  // Emergency preparedness. `dpaCardUpToDate` = the member holds an up-to-date
  // DPA card (directive médicale anticipée); `survivalBackpackReady` = their
  // survival backpack is ready. `emergencyContacts` are third parties to reach
  // about the member in a crisis (scrubbed on anonymize).
  dpaCardUpToDate       Boolean @default(false)
  survivalBackpackReady Boolean @default(false)

  // Domain status. `isPublisher = false` means ministry-school student. Whether a publisher is a
  // pioneer is NOT stored here — it is their PioneerEnrolment stints, so that a standing status and
  // the period it covers cannot disagree.
  isPublisher Boolean       @default(false)
  baptismDate DateTime?
  isAnointed  Boolean       @default(false)
  isHelder    Boolean       @default(false)
  isServant   Boolean       @default(false)

  // Group
  publisherGroupId Int?
  publisherGroup   PublisherGroup? @relation("group", fields: [publisherGroupId], references: [id])
  responsibleFor   PublisherGroup? @relation("groupResponsible")
  deputyFor        PublisherGroup? @relation("groupDeputy")

  // Lifecycle. Three orthogonal dimensions:
  //   leftAt        — soft-leave; reversible. Hides Member from publisher-facing lists.
  //   inactiveAt    — publisher hasn't preached for 6 consecutive monthly reports. Hides them
  //                   from public display-board surfaces (groups, pioneers) and from active-publisher
  //                   stats. Auto-set by evaluateInactiveStatus on activity writes; cleared when an
  //                   hours report arrives. Reversible; can also be set manually by a publisher manager.
  //   anonymizedAt  — GDPR scrub; irreversible. PII fields cleared, activity rows preserved.
  leftAt       DateTime?
  inactiveAt   DateTime?
  anonymizedAt DateTime?

  // Optional 1:1 to a login account
  account UserAccount?

  // Domain relations (FK target Member.id)
  attributions                Attribution[]       @relation("publisher")
  activities                  PublisherActivity[] @relation("publisherActivity")
  pioneerEnrolments           PioneerEnrolment[]
  eventPartsAsAssignee        EventPart[]         @relation("partAssignee")
  eventPartsAsAssistant       EventPart[]         @relation("partAssistant")
  eventServicePartsAsAssignee EventServicePart[]  @relation("servicePartAssignee")

  // Identity-role assignments (built-in roles like brother/elder/pioneer plus
  // any custom role the user may add later that expresses identity)
  roleAssignments MemberRoleAssignment[]

  emergencyContacts EmergencyContact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, congregationId])
  @@index([congregationId, leftAt])
  @@index([congregationId, firstnameNormalized])
  @@index([congregationId, lastnameNormalized])
}

// A person to contact about a Member in an emergency — either to get
// information about the Member's situation or to pass information on. Holds
// third-party PII (name + phone), so it is purged when the Member is
// anonymized. Owned by the Member; no invariants of its own.
model EmergencyContact {
  id           Int    @id @default(autoincrement())
  // biome-ignore lint/style/useNamingConvention: Prisma composite FK
  member       Member @relation(fields: [memberId, congregationId], references: [id, congregationId], onDelete: Cascade)
  memberId     Int
  name         String
  relationship String @default("") // free text: ami, famille, enfant, conjoint…
  phone        String @default("")

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  createdAt DateTime @default(now())

  @@unique([id, congregationId])
  @@index([congregationId])
  @@index([memberId, congregationId])
}

// A login. Always has an email + password. Optionally points at a Member.
//
// When `memberId` is null, the account belongs to a circuit overseer or
// external admin who is not part of this congregation. The display
// `firstname` / `lastname` fields are used in that case; when `memberId`
// is set, name comes from the linked Member.
//
// Note: AuditLog.actorId, NotificationEvent.{actorId,recipientId} are loose
// `Int?` fields without FK constraints; their semantic target is UserAccount.id.
model UserAccount {
  id             Int          @id @default(autoincrement())
  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  memberId Int?    @unique

  // Display fallback. Only used when `memberId` is null. When linked to a
  // Member, these stay null and the Member's name is the source of truth.
  firstname String?
  lastname  String?

  email           String    @unique
  password        String
  active          Boolean   @default(true)
  emailVerifiedAt DateTime?
  platformAdmin   Boolean   @default(false)
  anonymizedAt    DateTime?

  // Session epoch. Embedded in the session cookie when a session is established and
  // compared on every request in verifySession. Incremented on password change/reset
  // and on admin invalidation to revoke all previously-issued sessions ("log out everywhere").
  sessionEpoch Int @default(0)

  // Optional TOTP two-factor authentication.
  // twoFactorSecret holds the AES-256-GCM ciphertext of the base32 seed (null = never enrolled).
  // twoFactorEnabledAt is null while enrollment is pending (secret generated, not yet confirmed)
  // and set once confirmed — only then is the login challenge armed.
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?

  // Account-bound relations
  roleAssignments          UserRoleAssignment[] // management/access roles
  eventsCreated            Event[]                    @relation("createdBy")
  documentsViewed          BoardDocument[]            @relation("viewedBy")
  documentVersionUploads   BoardDocumentVersion[]     @relation("boardDocumentVersionUploader")
  dynamicDocumentViews     BoardDynamicDocumentView[]
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  calendarFeedTokens       CalendarFeedToken[]
  consentRecords           ConsentRecord[]
  notificationPreferences  NotificationPreference[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, congregationId])
}

model Permission {
  id              Int              @id @default(autoincrement())
  key             String           @unique
  rolePermissions RolePermission[]
}

model Role {
  id          Int     @id @default(autoincrement())
  key         String
  name        String?
  description String?
  isBuiltIn   Boolean @default(false)

  permissions       RolePermission[]
  members           UserRoleAssignment[]
  memberAssignments MemberRoleAssignment[]

  allowedForTemplateParts        TemplatePartAllowedRole[]
  allowedForEventParts           EventPartAllowedRole[]
  allowedForTemplateServiceParts TemplateServicePartAllowedRole[]
  allowedForEventServiceParts    EventServicePartAllowedRole[]
  allowedForBoardSections        BoardSectionVisibilityRole[]
  allowedForTerritoryKinds       TerritoryKindAllowedRole[]
  templateResponsibilities       TemplateResponsible[]           @relation("templateResponsible")

  // Organigram: reporting structure, and nothing else.
  //
  // `parentRoleId` is NEVER traversed by permission resolution. The chart's root is the
  // `elder` roster, so inheriting downward would make every seated person an elder, and
  // inheriting upward would hand every elder every permission in the congregation. A person's
  // permissions come only from the roles they are actually in — see
  // `resolveEffectivePermissions` in app/shared/auth/permissions.server.ts.
  //
  // The FK is composite so a role cannot be parented into another congregation: that is
  // enforced by Postgres against @@unique([id, congregationId]) below, not by a service check.
  // MATCH SIMPLE means a null parent skips the check, so roots need no special case.
  parentRoleId Int?
  parentRole   Role?  @relation("roleTree", fields: [parentRoleId, congregationId], references: [id, congregationId], onDelete: Restrict, onUpdate: NoAction)
  children     Role[] @relation("roleTree")

  showInOrganigram Boolean @default(false)
  organigramOrder  Int?
  // Free text for a group named without listing its people, e.g. « Équipe des préposés à l'accueil ».
  organigramNote   String?
  // A personal role: one titular `leader` seat, with a handover on re-seating. Deputies are
  // still allowed — an adjoint is either a deputy seat here or a child personal role. The three
  // committee posts carry this; congregations set it on their own «Responsable …» roles.
  isSinglePerson   Boolean @default(false)

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, congregationId])
  @@unique([id, congregationId])
}

model RolePermission {
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId   Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([roleId, permissionId])
  @@index([congregationId])
  @@index([permissionId])
}

// Management/access role assignments (e.g. Roles Manager, Territory Manager).
// Granted manually by a Roles Manager. Permissions resolve through
// `UserRoleAssignment` → `Role` → `RolePermission`.
model UserRoleAssignment {
  user           UserAccount  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  // Which seat this person occupies in an organigram node: leader | deputy | member.
  // Defaults to `member`, which is correct for every pre-existing row and for every grant
  // made outside the organigram — only the seating UI ever writes anything else.
  kind String @default("member")

  @@id([userId, roleId])
  @@index([congregationId])
  @@index([roleId])
}

// Identity role assignments (e.g. brother, elder, pioneer, publisher).
// Auto-synced from Member flags by `syncBuiltInRoleAssignments`. Permissions
// reach the linked UserAccount through this table too — every reader that
// resolves an account's permissions or role membership must union this with
// UserRoleAssignment. The canonical primitives live in
// app/shared/auth/permissions.server.ts.
model MemberRoleAssignment {
  member         Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  memberId       Int
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([memberId, roleId])
  @@index([congregationId])
  @@index([roleId])
}

model BoardSection {
  id               Int                            @id @default(autoincrement())
  name             String
  order            Int?
  documents        BoardDocument[]
  dynamicDocuments BoardDynamicDocumentSettings[]
  visibilityRoles  BoardSectionVisibilityRole[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model BoardSectionVisibilityRole {
  section        BoardSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId      Int
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([sectionId, roleId])
  @@index([roleId])
  @@index([congregationId])
}

model BoardDocument {
  id            Int                    @id @default(autoincrement())
  title         String
  uri           String?
  thumbnailUri  String?
  section       BoardSection           @relation(fields: [sectionId], references: [id])
  sectionId     Int
  order         Int?
  type          String?
  visibleFrom   DateTime?
  visibleUntil  DateTime?
  viewedBy      UserAccount[]          @relation("viewedBy")
  isHighlighted Boolean                @default(false)
  createdAt     DateTime               @default(now())
  versions      BoardDocumentVersion[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([sectionId])
}

model BoardDocumentVersion {
  id            Int           @id @default(autoincrement())
  document      BoardDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    Int
  uri           String
  thumbnailUri  String?
  versionNumber Int           @default(1)
  uploadedBy    UserAccount?  @relation("boardDocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById  Int?
  createdAt     DateTime      @default(now())

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([documentId])
}

model BoardDynamicDocumentSettings {
  id            Int                        @id @default(autoincrement())
  title         String
  dynamicType   String
  dynamicRef    String?
  dynamicConfig Json?
  section       BoardSection               @relation(fields: [sectionId], references: [id])
  sectionId     Int
  order         Int?
  visibleFrom   DateTime?
  visibleUntil  DateTime?
  isHighlighted Boolean                    @default(false)
  showServices  Boolean                    @default(false)
  createdAt     DateTime                   @default(now())
  views         BoardDynamicDocumentView[]

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([sectionId])
}

model BoardDynamicDocumentView {
  id         Int                          @id @default(autoincrement())
  settings   BoardDynamicDocumentSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)
  settingsId Int
  user       UserAccount                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  viewedAt   DateTime                     @default(now())

  @@unique([settingsId, userId])
  @@index([userId])
}

// A kind of territory, per congregation. The five built-ins are seeded from
// `TerritoryKindKey` at congregation setup; `key` becomes a free-form slug once
// congregations can define their own kinds. `Territory.type` still points at the
// enum — moving it onto a FK here is a later change.
model TerritoryKind {
  id        Int     @id @default(autoincrement())
  key       String
  // null for built-ins — the label comes from i18n, as it does for Role
  name      String?
  isBuiltIn Boolean @default(true)

  allowedRoles TerritoryKindAllowedRole[]

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, congregationId])
  @@unique([id, congregationId])
  @@index([congregationId])
}

// Roles a publisher must hold to be attributed a territory of this kind.
// No rows for a kind means no restriction — any active publisher qualifies.
model TerritoryKindAllowedRole {
  kind           TerritoryKind @relation(fields: [kindId, congregationId], references: [id, congregationId], onDelete: Cascade)
  kindId         Int
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId         Int
  congregation   Congregation  @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@id([kindId, roleId])
  @@index([roleId])
  @@index([congregationId])
}

model Territory {
  id             Int                 @id @default(autoincrement())
  number         String
  type           TerritoryKindKey    @default(Classical)
  notes          String              @default("")
  attributions   Attribution[]       @relation("territory")
  campaignScopes CampaignTerritory[]
  entrances      BuildingEntrance[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
}

model TerritoryPerimeter {
  id        Int      @id @default(autoincrement())
  paths     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int          @unique

  @@unique([id, congregationId])
}

model TerritoryCardOverlay {
  id        Int      @id @default(autoincrement())
  name      String?
  color     String
  paths     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id], onDelete: Cascade)
  congregationId Int

  @@unique([id, congregationId])
  @@index([congregationId])
}

model Attribution {
  id          Int                      @id @default(autoincrement())
  type        TerritoryAttributionKind @default(Default)
  publisher   Member                   @relation("publisher", fields: [publisherId], references: [id])
  territory   Territory                @relation("territory", fields: [territoryId], references: [id])
  publisherId Int
  territoryId Int
  startDate   DateTime                 @default(now())
  endDate     DateTime?
  lateDate    DateTime
  notes       String                   @default("")

  // Campaign layer — orthogonal to `type` (the method). null = regular work.
  campaign   Campaign? @relation("campaignAttributions", fields: [campaignId, congregationId], references: [id, congregationId])
  campaignId Int?

  // Pause state — still open (endDate = null) but inactive; overdue clock frozen.
  // pausedByCampaignId records which campaign paused it so end/scope transitions
  // only ever touch their own rows.
  pausedAt           DateTime?
  pausedByCampaign   Campaign? @relation("pausedAttributions", fields: [pausedByCampaignId, congregationId], references: [id, congregationId])
  pausedByCampaignId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([campaignId])
  @@index([pausedByCampaignId])
}

model Campaign {
  id        Int      @id @default(autoincrement())
  name      String
  notes     String   @default("")
  startDate DateTime // day-granular schedule; drives activation (congregation-local dates)
  endDate   DateTime // inclusive — the last day the campaign runs

  restPeriodDays Int? // post-campaign rest for its territories, in days; null -> 15-day default

  // lifecycle options — orthogonal, set before start
  startRegularAction CampaignRegularStartAction @default(Pause)
  startAutoReassign  Boolean                    @default(false)
  endCloseCampaign   Boolean                    @default(true)
  endRegularAction   CampaignRegularEndAction   @default(Resume)

  // lifecycle bookkeeping — set by the job (idempotency + "is mode on?")
  activatedAt DateTime?
  endedAt     DateTime?

  attributions       Attribution[]       @relation("campaignAttributions")
  pausedAttributions Attribution[]       @relation("pausedAttributions")
  scope              CampaignTerritory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([congregationId])
}

model CampaignTerritory {
  campaign    Campaign  @relation(fields: [campaignId, congregationId], references: [id, congregationId], onDelete: Cascade)
  campaignId  Int
  territory   Territory @relation(fields: [territoryId, congregationId], references: [id, congregationId], onDelete: Cascade)
  territoryId Int

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@id([campaignId, territoryId])
  @@index([congregationId])
}

model BuildingEntrance {
  id          Int         @id @default(autoincrement())
  territories Territory[]
  buildings   Building[]

  kind     EntranceKind @default(Residential)
  shopKind String       @default("")

  // Materialized aggregates for residential entrances (sum of BuildingResidentialData)
  homes    Int?
  phones   Int?
  liberals Int?

  // Centroid of the entrance's buildings; recomputed on building add/remove and on building coord change
  latitude  Float?
  longitude Float?

  access        Int?
  accesses      BuildingAccess[]
  isPMR         Boolean?
  isOpenEarly   Boolean?
  isMailboxOpen Boolean?

  residentialData BuildingResidentialData[]

  notes String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([congregationId, latitude, longitude])
}

model BuildingAccess {
  id         Int              @id @default(autoincrement())
  entrance   BuildingEntrance @relation(fields: [entranceId], references: [id], onDelete: Cascade)
  entranceId Int
  type       Int
  position   Int

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@index([entranceId])
}

model BuildingResidentialData {
  id         Int              @id @default(autoincrement())
  building   Building         @relation(fields: [buildingId], references: [id])
  buildingId Int              @unique
  entrance   BuildingEntrance @relation(fields: [entranceId], references: [id], onDelete: Cascade)
  entranceId Int

  homes    Int?
  phones   Int?
  liberals Int?

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@index([entranceId])
}

model Building {
  id               Int      @id @default(autoincrement())
  number           String
  street           String
  // Search aid: lowercased, diacritic-stripped copy of street.
  // Maintained at write-time so search queries can stay in pure Prisma.
  streetNormalized String   @default("")
  zip              String
  latitude         Float?
  longitude        Float?
  active           Boolean  @default(true)
  inTerritory      Boolean  @default(true)
  inOpenData       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prospectionDate DateTime?
  entrances       BuildingEntrance[]
  residentialData BuildingResidentialData?

  notes          String @default("")
  importantNotes String @default("")

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([number, street, zip, congregationId], name: "address")
  @@unique([id, congregationId])
  @@index([congregationId, streetNormalized])
}

