model EventPart {
  id          Int     @id @default(autoincrement())
  topic       String  @default("")
  note        String  @default("")
  hasConflict Boolean @default(false)

  // Inline fields (copied from template part on generation, or set manually for custom parts)
  name         String  @default("")
  section      String  @default("")
  track        String  @default("")
  trackOrder   Int?
  order        Int     @default(0)
  durationMin  Int?
  // Per-part display labels for the two role slots. Denormalized from the
  // template at apply time so historical assignments stay stable when the
  // template later changes. Null → i18n default (part-labels.ts helper).
  speakerLabel String?
  readerLabel  String?

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId Int

  part   TemplatePart? @relation(fields: [partId], references: [id], onDelete: SetNull)
  partId Int?

  // Carried from the template part at generation time. Unlike the label and
  // duration fields above, nothing is denormalized off the preset: the share
  // message is resolved live so an improved wording applies to assignments
  // that already exist.
  preset   PartPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)
  presetId Int?

  assignee   Member? @relation("partAssignee", fields: [assigneeId], references: [id])
  assigneeId Int?

  assistant   Member? @relation("partAssistant", fields: [assistantId], references: [id])
  assistantId Int?

  allowExternalSpeaker Boolean @default(false)

  externalSpeaker   ExternalSpeaker? @relation(fields: [externalSpeakerId], references: [id], onDelete: SetNull)
  externalSpeakerId Int?

  allowedRoles EventPartAllowedRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  congregation   Congregation @relation(fields: [congregationId], references: [id])
  congregationId Int

  @@unique([id, congregationId])
  @@index([externalSpeakerId])
  @@index([eventId])
  @@index([partId])
  @@index([presetId])
}

