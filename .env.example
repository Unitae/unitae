# =============================================================================
# Unitae — Environment Variables
# =============================================================================
# Copy this file to .env and adjust the values.
#   cp .env.example .env

# --- Required -----------------------------------------------------------------

# PostgreSQL connection string
# Dev: postgresql://unitae:unitae@localhost:5432/unitae_dev
# Docker Compose: postgresql://unitae:YOUR_PASSWORD@postgres:5432/unitae
# PM2: postgresql://unitae:YOUR_PASSWORD@localhost:5432/unitae
DATABASE_URL="postgresql://unitae:unitae@localhost:5432/unitae_dev"

# Secret key for signing session cookies (32+ characters)
SESSION_SECRET="change-me-with-a-real-secret-key"

# --- Docker Compose (production only) ----------------------------------------

# PostgreSQL password (required for docker-compose.yml)
# POSTGRES_PASSWORD="your-postgres-password"

# PostgreSQL database name
# POSTGRES_DB="unitae"

# Docker image to use (defaults to ghcr.io/unitae/unitae:latest)
# UNITAE_IMAGE="ghcr.io/unitae/unitae:latest"

# --- Application --------------------------------------------------------------

# Base URL used in emails and redirects
# APP_BASE_URL="https://your-domain.com"

# Node.js environment (development | production)
# NODE_ENV="development"

# Winston log level (error | warn | info | debug)
# LOG_LEVEL="info"

# Session cookie domain (leave empty in dev, set in production)
# COOKIE_DOMAIN=".your-domain.com"

# --- Redis (BullMQ queues + rate limiting) ------------------------------------

# Dev / PM2: localhost — Docker Compose: redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD="your-redis-password"

# --- S3 Storage (document uploads) --------------------------------------------
# Optional: file storage is disabled if S3_ENDPOINT is not set.

# S3_ENDPOINT="https://s3.example.com"
# S3_REGION="auto"
# S3_BUCKET="unitae"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# --- Email (Resend) -----------------------------------------------------------
# Optional: emails are disabled if RESEND_API_KEY is not set.

# RESEND_API_KEY="re_123"

# --- Worker -------------------------------------------------------------------

# Health server port for the BullMQ worker
# WORKER_HEALTH_PORT="9090"
