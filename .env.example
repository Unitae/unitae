# =============================================================================
# Unitae — Environment Variables
# =============================================================================
# Copy this file to .env and adjust the values.
#   cp .env.example .env

# --- Required -----------------------------------------------------------------

# PostgreSQL connection string (superuser — used for migrations)
# Dev: postgresql://unitae:unitae@localhost:5432/unitae_dev
# Docker Compose: postgresql://unitae:YOUR_PASSWORD@postgres:5432/unitae
# PM2: postgresql://unitae:YOUR_PASSWORD@localhost:5432/unitae
DB_URL="postgresql://unitae:unitae@localhost:5432/unitae_dev"

# Secret key(s) for signing session cookies. Minimum 32 characters; the app refuses
# to boot in production on a short secret or this placeholder value. To rotate without
# logging everyone out, put the new secret first and keep old ones after it, comma-
# separated: "new-secret,old-secret". Slot 0 signs new cookies; the rest still validate
# existing cookies and decrypt enrolled 2FA seeds.
UNITAE_SESSION_SECRET="change-me-with-a-real-secret-key"

# --- Database -----------------------------------------------------------------

# Non-superuser connection string for the runtime — enables RLS enforcement.
# REQUIRED IN PRODUCTION: the app refuses to boot when this is unset or points at a
# superuser / BYPASSRLS role (it would run with no database-level tenant isolation).
# In development it falls back to DB_URL with a warning. The Docker Compose stack
# defaults this to the unitae_app role. See docs/development/row-level-security.md
# Dev: postgresql://unitae_app:unitae_app@localhost:5432/unitae_dev
# Docker Compose: postgresql://unitae_app:YOUR_APP_PASSWORD@postgres:5432/unitae
# DB_RUNTIME_URL="postgresql://unitae_app:YOUR_APP_PASSWORD@localhost:5432/unitae_dev"

# Maximum number of PostgreSQL connections in the pool
# DB_POOL_MAX="10"

# --- Docker Compose -----------------------------------------------------------

# PostgreSQL superuser
# DB_USER="unitae"

# PostgreSQL password (required for docker-compose.yml)
# DB_PASSWORD="your-postgres-password"

# PostgreSQL database name
# DB_NAME="unitae"

# Password for the unitae_app non-superuser role (RLS enforcement).
# Defaults to DB_PASSWORD if not set.
# DB_RUNTIME_PASSWORD="your-app-password"

# Docker images
# UNITAE_WEB_IMAGE="ghcr.io/unitae/unitae:latest"
# UNITAE_WORKER_IMAGE="ghcr.io/unitae/unitae/worker:latest"
# UNITAE_MIGRATE_IMAGE="ghcr.io/unitae/unitae/migrate:latest"

# --- Application --------------------------------------------------------------

# Base URL used in emails and redirects
# UNITAE_BASE_URL="https://your-domain.com"

# HTTP server port
# UNITAE_WEB_PORT="8080"

# Node.js environment (development | production)
# NODE_ENV="development"

# Winston log level (error | warn | info | debug)
# UNITAE_LOG_LEVEL="info"

# Session cookie domain (leave empty in dev, set in production)
# UNITAE_COOKIE_DOMAIN=".your-domain.com"

# Bearer token for authenticating cron endpoint requests (/cron/*).
# When unset, all cron endpoints reject with 401.
# UNITAE_CRON_SECRET="your-cron-secret"

# Multi-tenant mode. Only "true" enables the public /register route so visitors can
# create their own congregation; self-hosters leave this off and get a single-tenant
# app. Tenant isolation (RLS, congregationId) is always active either way.
# UNITAE_MULTI_TENANT="false"

# --- Security -----------------------------------------------------------------

# Strict-Transport-Security header value, emitted over HTTPS only.
# Defaults to "max-age=63072000" (2 years) WITHOUT includeSubDomains/preload, because
# the app cannot know your subdomain topology and those directives are near-irreversible
# for the max-age window. Override only when you control every subdomain of the
# registrable domain. A malformed value (e.g. a stray newline) is ignored in favour of
# the default, so a valid header is always sent.
# UNITAE_HSTS_HEADER="max-age=63072000; includeSubDomains; preload"

# Failed-login rate limits, counted in a rolling 15-minute window.
# Keyed on client IP and on an instance-wide counter — never on the target email, so
# nobody can lock a specific victim out by burning their budget.
# LOGIN_RATE_LIMIT_IP_MAX="10"
# LOGIN_RATE_LIMIT_GLOBAL_MAX="100"

# Failed TOTP attempts per pending account, same 15-minute window. Keyed on the account
# rather than the IP: this step runs only after the correct password.
# TWO_FACTOR_RATE_LIMIT_MAX="5"

# --- Redis (BullMQ queues + rate limiting) ------------------------------------

# Dev / PM2: localhost — Docker Compose: redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD="your-redis-password"

# --- File Storage -------------------------------------------------------------
# By default, uploaded files are stored on the local filesystem.
# Set S3_ENDPOINT to switch to S3-compatible storage.

# Local filesystem storage directory
# UNITAE_STORAGE_PATH="content/uploads"

# S3-compatible storage (optional)
# S3_ENDPOINT="https://s3.example.com"
# S3_REGION="auto"
# S3_BUCKET="unitae"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# --- Email (Resend) -----------------------------------------------------------
# Optional: emails are disabled if RESEND_API_KEY is not set.

# RESEND_API_KEY="re_123"

# Default sender address for outgoing emails
# UNITAE_EMAIL_FROM="Unitae <noreply@your-domain.com>"

# --- Maps (optional) ----------------------------------------------------------

# Google Maps API key. Enables maps on territory pages and in PDF exports.
# Requires Maps JavaScript API and Maps Static API enabled.
# GOOGLE_MAPS_API_KEY=""

# Google Maps Map ID for custom styled maps. Requires GOOGLE_MAPS_API_KEY.
# GOOGLE_MAPS_MAP_ID=""

# --- Open data (optional) -----------------------------------------------------

# Extra hostnames allowed as a source for the BANO / open-address import, comma-
# separated. These are ADDED to the built-in list (bano.openstreetmap.fr,
# adresse.data.gouv.fr, data.gouv.fr). The allowlist is an SSRF guard — only add hosts
# you trust, e.g. a private mirror.
# UNITAE_OPEN_DATA_ALLOWLIST="mirror.example.org,data.example.org"

# --- Worker -------------------------------------------------------------------

# Health server port for the BullMQ worker
# UNITAE_WORKER_HEALTH_PORT="9090"
